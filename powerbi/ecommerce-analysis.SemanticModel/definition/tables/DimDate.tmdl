		formatString: 0
		lineageTag: 694aae9c-7f8a-4501-957c-fc8533d82e83
		summarizeBy: sum
		sourceColumn: MonthNumber

		annotation SummarizationSetBy = Automatic

	column MonthName
		dataType: string
		lineageTag: 72bf4522-ca0a-4590-bfb2-1990341e31dc
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNumber

		changedProperty = SortByColumn

