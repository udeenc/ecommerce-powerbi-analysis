table DimDate
	lineageTag: b454a94d-5162-43e9-858e-b0e7445446cf
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 19224f13-8f63-4d0f-b9ad-f1ea066462c4
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 11a2f438-0c16-4e25-a160-51b84a7658e6
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Quarter
